{
	"iisSettings": {
		"windowsAuthentication": false,
		"anonymousAuthentication": true,
		"iisExpress": {
			"applicationUrl": "http://localhost:55733",
			"sslPort": 44389
		}
	},
	"profiles": {
		// This profile is first in order for dotnet run to pick it up by default
		"UnoChefsInfragistics (WebAssembly)": {
			"commandName": "Project",
			"dotnetRunMessages": true,
			"launchBrowser": true,
			"applicationUrl": "http://localhost:51480",
			"inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		"UnoChefsInfragistics (WebAssembly IIS Express)": {
			"commandName": "IISExpress",
			"launchBrowser": true,
			"inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		"UnoChefsInfragistics (WinAppSDK Unpackaged)": {
			"commandName": "Project",
			"compatibleTargetFramework": "windows"
		},
		"UnoChefsInfragistics (WinAppSDK Packaged)": {
			"commandName": "MsixPackage",
			"compatibleTargetFramework": "windows"
		},
		"UnoChefsInfragistics (Desktop)": {
			"commandName": "Project",
			"compatibleTargetFramework": "desktop"
		},
		"UnoChefsInfragistics (Desktop WSL2)": {
			"commandName": "WSL2",
			"commandLineArgs": "{ProjectDir}/bin/Debug/net10.0-desktop/UnoChefsInfragistics.dll",
			"distributionName": "",
			"compatibleTargetFramework": "desktop"
		}
	}
}