<Page x:Class="Chefs.Views.MealPlannerPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:uen="using:Uno.Extensions.Navigation.UI"
	  xmlns:uer="using:Uno.Extensions.Reactive.UI"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  xmlns:igc="using:Infragistics.Controls.Charts"
	  xmlns:igg="using:Infragistics.Controls.Gauges"
	  xmlns:igd="using:Infragistics.Controls.Grids"
	  utu:StatusBar.Background="{ThemeResource SurfaceInverseBrush}"
	  utu:StatusBar.Foreground="AutoInverse"
	  NavigationCacheMode="Enabled"
	  mc:Ignorable="d"
	  Background="{ThemeResource BackgroundBrush}">

	<utu:AutoLayout>
		<utu:NavigationBar>
			<utu:NavigationBar.Content>
				<Grid>
					<Image Source="{ThemeResource ChefsAppSignature}"
						   HorizontalAlignment="Left"
						   Width="128"
						   Height="40" />
				</Grid>
			</utu:NavigationBar.Content>
			<utu:NavigationBar.PrimaryCommands>
				<AppBarButton uen:Navigation.Request="!Profile">
					<AppBarButton.Icon>
						<PathIcon Data="{StaticResource Icon_Person_Outline}" />
					</AppBarButton.Icon>
				</AppBarButton>
				<AppBarButton uen:Navigation.Request="!Notifications">
					<AppBarButton.Icon>
						<PathIcon Data="{StaticResource Icon_Notification_Bell}" />
					</AppBarButton.Icon>
				</AppBarButton>
			</utu:NavigationBar.PrimaryCommands>
		</utu:NavigationBar>

		<uer:FeedView Source="{Binding Plan}"
					  utu:AutoLayout.PrimaryAlignment="Stretch">
			<DataTemplate>
				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  HorizontalScrollMode="Disabled">
					<utu:AutoLayout Padding="{utu:Responsive Normal=16, Wide=24}"
									Spacing="16">
						<utu:AutoLayout Spacing="4">
							<TextBlock Text="This week's meal plan"
									   Foreground="{ThemeResource OnBackgroundBrush}"
									   Style="{StaticResource TitleLarge}" />
							<TextBlock Foreground="{ThemeResource OnSurfaceVariantBrush}"
									   Style="{StaticResource BodyMedium}">
								<Run Text="{Binding Data.Meals.Count}" />
								<Run Text="meals planned •" />
								<Run Text="{Binding Data.TotalCookHours}" />
								<Run Text="hours of cooking" />
							</TextBlock>
						</utu:AutoLayout>

						<!-- Calories by day (chart) next to average vs. goal (gauge) -->
						<Grid ColumnSpacing="16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="320" />
							</Grid.ColumnDefinitions>

							<utu:AutoLayout Padding="16"
											Spacing="8"
											Background="{ThemeResource SurfaceBrush}"
											CornerRadius="12">
								<utu:AutoLayout Orientation="Horizontal"
												Justify="SpaceBetween"
												CounterAxisAlignment="Center">
									<TextBlock Text="Calories by day"
											   Foreground="{ThemeResource OnSurfaceBrush}"
											   Style="{StaticResource TitleMedium}" />
									<igc:Legend x:Name="MealLegend"
												Orientation="Horizontal" />
								</utu:AutoLayout>
								<igc:XamCategoryChart Height="280"
													  ItemsSource="{Binding Data.Daily}"
													  ChartType="Column"
													  IsTransitionInEnabled="True"
													  ToolTipType="Category"
													  YAxisTitle="kcal"
													  Legend="{Binding ElementName=MealLegend}"
													  XAxisLabelTextColor="{ThemeResource OnSurfaceVariantBrush}"
													  YAxisLabelTextColor="{ThemeResource OnSurfaceVariantBrush}"
													  Loaded="OnCaloriesChartLoaded" />
							</utu:AutoLayout>

							<utu:AutoLayout Grid.Column="1"
											Padding="16"
											Spacing="8"
											Background="{ThemeResource SurfaceBrush}"
											CornerRadius="12">
								<TextBlock Text="Average daily calories"
										   Foreground="{ThemeResource OnSurfaceBrush}"
										   Style="{StaticResource TitleMedium}" />
								<igg:XamRadialGauge Height="240"
													MinimumValue="0"
													MaximumValue="2400"
													Interval="400"
													Value="{Binding Data.AverageDailyCalories}"
													FontSize="14"
													NeedleBrush="{ThemeResource PrimaryBrush}"
													NeedleOutline="{ThemeResource PrimaryBrush}"
													NeedlePivotBrush="{ThemeResource PrimaryBrush}"
													NeedlePivotOutline="{ThemeResource PrimaryBrush}"
													FontBrush="{ThemeResource OnSurfaceVariantBrush}"
													TickBrush="{ThemeResource OnSurfaceVariantBrush}"
													MinorTickBrush="{ThemeResource OutlineVariantBrush}"
													BackingBrush="{ThemeResource SurfaceBrush}"
													BackingOutline="{ThemeResource SurfaceBrush}"
													Loaded="OnCalorieGaugeLoaded" />
								<TextBlock utu:AutoLayout.CounterAlignment="Center"
										   Foreground="{ThemeResource OnSurfaceBrush}"
										   Style="{StaticResource HeadlineSmall}">
									<Run Text="{Binding Data.AverageDailyCalories}" />
									<Run Text="kcal / day"
										 FontSize="14" />
								</TextBlock>
								<TextBlock utu:AutoLayout.CounterAlignment="Center"
										   Foreground="{ThemeResource OnSurfaceVariantBrush}"
										   Style="{StaticResource BodySmall}">
									<Run Text="Goal:" />
									<Run Text="{Binding Data.DailyGoal}" />
									<Run Text="kcal (green band)" />
								</TextBlock>
							</utu:AutoLayout>
						</Grid>

						<!-- The week's meals grouped by day, with a calorie total per day -->
						<utu:AutoLayout Padding="16"
										Spacing="8"
										Background="{ThemeResource SurfaceBrush}"
										CornerRadius="12">
							<TextBlock Text="Schedule"
									   Foreground="{ThemeResource OnSurfaceBrush}"
									   Style="{StaticResource TitleMedium}" />
							<igd:XamDataGrid Height="560"
											 ItemsSource="{Binding Data.Meals}"
											 AutoGenerateColumns="False"
											 RowHeight="30"
											 SelectionMode="SingleRow"
											 IsGroupRowSticky="True"
											 HeaderClickAction="SortByOneColumnOnly"
											 Background="{ThemeResource SurfaceBrush}"
											 CellBackground="{ThemeResource SurfaceBrush}"
											 CellTextColor="{ThemeResource OnSurfaceBrush}"
											 HeaderBackground="{ThemeResource SurfaceVariantBrush}"
											 HeaderTextColor="{ThemeResource OnSurfaceVariantBrush}"
											 SectionHeaderBackground="{ThemeResource SecondaryContainerBrush}"
											 SectionHeaderTextColor="{ThemeResource OnSecondaryContainerBrush}"
											 RowHoverBackground="{ThemeResource SurfaceVariantBrush}"
											 CellSelectedBackground="{ThemeResource PrimaryContainerBrush}">
								<igd:XamDataGrid.GroupDescriptions>
									<igd:ColumnGroupDescription Field="DayLabel"
																DisplayName="Plan" />
								</igd:XamDataGrid.GroupDescriptions>
								<igd:XamDataGrid.SummaryDescriptions>
									<igd:ColumnSummaryDescription Field="Calories"
																  Operand="Sum"
																  DisplayName="Total kcal" />
								</igd:XamDataGrid.SummaryDescriptions>
								<igd:XamDataGrid.Columns>
									<igd:ImageColumn Field="ImageFileUri"
													 HeaderText=""
													 ImageResourceType="RemoteResource"
													 ImageStretchOption="Uniform"
													 IsSortingEnabled="False" />
									<igd:TextColumn Field="Meal"
													HeaderText="Meal" />
									<igd:TextColumn Field="Recipe"
													HeaderText="Recipe" />
									<igd:NumericColumn Field="CookMinutes"
													   HeaderText="Cook time"
													   PositiveSuffix=" min" />
									<igd:NumericColumn Field="Calories"
													   HeaderText="Calories"
													   PositiveSuffix=" kcal" />
								</igd:XamDataGrid.Columns>
							</igd:XamDataGrid>
						</utu:AutoLayout>
					</utu:AutoLayout>
				</ScrollViewer>
			</DataTemplate>
		</uer:FeedView>
	</utu:AutoLayout>
</Page>