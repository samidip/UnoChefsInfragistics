<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Chefs.Views.Controls.ChartControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ig="using:Infragistics.Controls.Charts"
			 xmlns:igg="using:Infragistics.Controls.Gauges"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:utu="using:Uno.Toolkit.UI"
			 mc:Ignorable="d">

	<!-- Infragistics XamDoughnutChart + XamBulletGraph showing macro nutrients per serving -->

	<Grid RowSpacing="{utu:Responsive Normal=5, Wide=24}">
		<Grid.RowDefinitions>
			<RowDefinition Height="140" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ig:XamDoughnutChart x:Name="doughnutChart"
							 InnerExtent="0.7"
							 AllowSliceSelection="False"
							 AllowSliceExplosion="False">
			<ig:XamDoughnutChart.Series>
				<ig:RingSeries x:Name="ringSeries"
							   ValueMemberPath="Value"
							   LabelMemberPath="Name"
							   LabelsPosition="None" />
			</ig:XamDoughnutChart.Series>
		</ig:XamDoughnutChart>

		<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center">
			<TextBlock HorizontalAlignment="Center"
					   FontSize="22"
					   Text="{Binding CaloriesAmount}" />
			<TextBlock HorizontalAlignment="Center"
					   FontSize="14"
					   Text="Calories" />
		</StackPanel>

		<StackPanel x:Name="bulletGraphs"
					Grid.Row="1"
					Spacing="4" />
	</Grid>
</UserControl>
